# =============================================================================
# Environment Configuration
# Copy this file to `.env` and adjust values as needed.
# =============================================================================

# Flask
FLASK_ENV=development
FLASK_DEBUG=true
HOST=0.0.0.0
PORT=5000

# AI Model
MODEL_NAME=OuteAI/Lite-Oute-1-300M-Instruct
MAX_NEW_TOKENS=250
GENERATION_TIMEOUT_SECONDS=300
MAX_REQUEST_BODY_BYTES=65536
LOAD_IN_8BIT=false


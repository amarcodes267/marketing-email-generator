# Flask
FLASK_ENV=development
FLASK_DEBUG=true
HOST=0.0.0.0
PORT=5000

# AI Model
MODEL_NAME=distilgpt2
MAX_NEW_TOKENS=250
GENERATION_TIMEOUT_SECONDS=300
MAX_REQUEST_BODY_BYTES=65536

